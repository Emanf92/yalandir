---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';

import ActanIcon from '../assets/chemicals/actan.jpg';
import ArenetromIcon from '../assets/chemicals/arenetrom.jpg';
import BiolonIcon from '../assets/chemicals/biolon.jpg';
import PotilinaIcon from '../assets/chemicals/potilina.jpg';
import TagtracinaIcon from '../assets/chemicals/tagtracina.jpg';

const chemicals = [
    { name: "Potilina", max: 32, icon: PotilinaIcon },
    { name: "Atcan", max: 16, icon: ActanIcon },
    { name: "Biolon", max: 14, icon: BiolonIcon },
    { name: "Arenetrom", max: 6, icon: ArenetromIcon },
    { name: "Tagtracina", max: 24, icon: TagtracinaIcon },
]

const actualValues = chemicals.map((chemical) => {
    return {
        ...chemical,
        actual: Math.floor(Math.random() * chemical.max),
    }
})
---
<Layout title="Chemicals">
    <div class="page">
        <h1>Chemicals</h1>
        <div class="chemicals-table">
            { actualValues.map((chemical, index) => {
                return <>
                    <div class={"icon" + (index===0?" first":"")}><Image src={chemical.icon} alt={chemical.name} /></div>
                    <div class={"chemical" + (index===0?" first":"")}><span>{chemical.name}</span></div>
                    <div class={"quantity" + (index===0?" first":"")}><span>{chemical.actual} / {chemical.max}</span></div>
                </>
            })}
        </div>
        <div class="actions">
            <button class="reset-button" onclick="location.reload()"><span>&#8634; Roll</span></button>
        </div>
    </div>
</Layout>
<style>
    .page {
        padding: 50px;
    }
    h1 {
        margin: 0;
        color: white;
    }
    .chemicals-table {
        margin-top: 30px;
        display: grid;
        flex-wrap: wrap;
        grid-template-columns: 60px 1fr 1fr;
        grid-gap: 0;
        justify-content: center;
        border: 1px solid white;
    }

    .chemicals-table .icon.first, .chemicals-table .chemical.first, .chemicals-table .quantity.first {
        border-top: 0;
    }

    .chemicals-table .icon, .chemicals-table .chemical, .chemicals-table .quantity {
        border-top: 1px dashed white;
        padding: 10px 20px;
        color: white;
        display: flex;
        align-items: center;
    }

    .chemicals-table .icon {
        padding: 0;
    }

    .chemicals-table .icon img {
        width: 100%;
        height: 100%;
    }

    .chemicals-table .chemical span {
        align-self: center;
    }

    .chemicals-table .chemical {
        border-right: 1px dashed white;
        font-weight: bold;
    }

    .actions {
        margin: 30px 0;
        display: flex;
        justify-content: flex-start;

        .reset-button {
            list-style: none;
            display: flex;
            padding: 1px;
            background-color: #23262d;
            background-image: none;
            background-size: 400%;
            border-radius: 7px;
            background-position: 100%;
            transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
            cursor: pointer;

            &:is(:hover, :focus-within) {
                background-position: 0;
                background-image: var(--accent-gradient);
            }

            span {
                width: 100%;
                text-decoration: none;
                line-height: 1.4;
                border-radius: 8px;
                color: white;
                background-color: #23262d;
                opacity: 0.8;
                display: grid;
                font-size: 24px;
                padding: 5px 12px;
            }
        }
    }
</style>
